# Copy to .env and fill in.  cp .env.example .env

# Shared secret between the phone and this server, at least 24 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SPAREDROID_TOKEN=

# Android package names the phone may listen to, read and operate. Nothing else is ever touched.
# Default: WeCom. Add more separated by commas, e.g. com.tencent.wework,com.example.shop
SPAREDROID_APPS=com.tencent.wework

# --- chat bot settings (skip these if you only forward notifications / read screens) ---

# The bot account's display name in WeCom groups, exactly as shown (used to recognise "@bot").
SPAREDROID_BOT_NAME=

# Which chats the bot works in, separated by |  (chat names may contain commas).
# * = every chat the bot account is in. Start with one test group.
SPAREDROID_CHATS=测试群
# Chats to never act in, even with *.
SPAREDROID_IGNORE_CHATS=

# What the bot does: module:function. Try examples.echo:handle first.
#   examples.keyword_faq:handle   FAQ from a JSON file, no AI
#   examples.claude_qa:handle     AI customer service (needs ANTHROPIC_API_KEY)
#   examples.order_intake:handle  formatted orders -> CSV, reply later
#   examples.notify_forward       any app's notifications -> a webhook
#   examples.screen_watch         open an app on a schedule, read the screen, alert on change
#   my_handler:handle             your own code
SPAREDROID_HANDLER=examples.echo:handle

# Public HTTPS address the phone uses (docker-compose + Caddy sets this up).
SPAREDROID_DOMAIN=bot.example.com
SPAREDROID_PUBLIC_URL=https://bot.example.com

# Optional: a WeCom *internal* group robot webhook. You get told when the phone
# goes offline, a reply fails, or a customer needs a human. Strongly recommended.
SPAREDROID_ALERT_WEBHOOK=

# Optional: rate limits (replies per minute). Bursts are what get accounts flagged.
# SPAREDROID_PER_CHAT_PER_MINUTE=6
# SPAREDROID_GLOBAL_PER_MINUTE=20

# Button texts in the chat app, if it is not WeCom in Chinese (e.g. Send / Reply).
# SPAREDROID_SEND_LABEL=发送
# SPAREDROID_QUOTE_LABEL=引用

# For examples.notify_forward / examples.screen_watch: see the top of those files.

# MCP server (sparedroid mcp): true = the AI assistant may look but not tap, type or send.
# SPAREDROID_MCP_READONLY=true

# For examples.claude_qa
# ANTHROPIC_API_KEY=
# SPAREDROID_KNOWLEDGE=examples/knowledge.example.md
